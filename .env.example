# ============================================================================
# .env — your settings. Copy this file to ".env" and edit the values.
# config.py READS these; you never edit config.py to change behaviour.
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
# ============================================================================

# --- The one you asked about: switch the live retrieval backend ---------------
# none = no retrieval (memory-only judge) | rag = vector precedents | wiki = curated KB
RETRIEVAL_BACKEND=none

# --- Temporal memory ----------------------------------------------------------
MEMORY_ENABLED=1          # 1 = judge sees user/thread history, 0 = off

# --- RAG / Qdrant (only used when RETRIEVAL_BACKEND=rag) -----------------------
RAG_ENABLED=0             # legacy live-RAG flag; RETRIEVAL_BACKEND supersedes it
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=moderation_records

# --- LLM (Tier-2 judge) -------------------------------------------------------
OLLAMA_MODEL=gpt-oss:120b-cloud

# --- Infrastructure (defaults match docker-compose; usually leave as-is) ------
ES_HOST=http://localhost:9200
INDEX_NAME=real_time_analysis
KAFKA_BROKERS=127.0.0.1:9093

# --- Reddit ingestion (optional — only for the Reddit source) -----------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hate-speech-pipeline by /u/yourname
